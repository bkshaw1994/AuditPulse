# SPA AuditPulse Production Environment Configuration
PORT=5001
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/spa_seo_db
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_CRAWLS=25

# External Business Scanner & Shareable Client Reports
EXTERNAL_AUDIT_API_KEY=your-secret-external-audit-api-key
PAGESPEED_API_KEY=your-google-pagespeed-insights-api-key
PUBLIC_REPORT_BASE_URL=https://auditpulse-dashboard-theta.vercel.app
